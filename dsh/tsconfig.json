{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["src", "tests"],
  "exclude": [
    "src/client",
    // JSX-importing client render tests are type-checked by tsconfig.client.json
    // and executed by vitest (esbuild); the node typecheck has no JSX runtime.
    "tests/section-render.smoke.test.ts",
    "tests/section-render.client.test.ts"
  ]
}
