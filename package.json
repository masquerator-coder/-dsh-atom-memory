{
  "name": "dsh-atom-memory-dsh",
  "version": "0.1.0",
  "description": "dsh-side integration for the dsh-atom-memory Python library: subprocess+stdio bridge, memory tools, LLM-first extraction, and durable capture hooks. Root bundle shell so the whole repo installs as one dsh profile layer via `dsh plugin --profile <name> add <git-url>`.",
  "type": "module",
  "main": "./dsh/lib/index.mjs",
  "types": "./dsh/lib/index.d.mts",
  "files": [
    "dsh/lib",
    "dsh/cordis.patch.yml",
    "dsh/README.md",
    "dsh/CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm --dir dsh build",
    "typecheck": "pnpm --dir dsh typecheck",
    "test": "pnpm --dir dsh test",
    "package": "pnpm --dir dsh build"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.3-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.3-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "Apache-2.0"
}
